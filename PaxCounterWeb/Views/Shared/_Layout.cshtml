@inject IConfiguration Configuration
@{
    var autoModeEnabled = Configuration.GetValue("DirectGps:AutoModeEnabled", false);
    var homeInterval = Math.Clamp(Configuration.GetValue("DirectGps:AutoModeHomeIntervalSeconds", 30), 5, 3600);
    var awayInterval = Math.Clamp(Configuration.GetValue("DirectGps:AutoModeAwayIntervalSeconds", 5), 5, 3600);
    var autoModeTrackerEntity = Configuration["DirectGps:AutoModeDeviceTrackerEntityId"] ?? "A52";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* <title>@ViewData["Title"] - PaxCounterWeb</title> *@
    <title>Monitorus</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-scoped.css" asp-append-version="true" />
</head>
<body>
    <div id="page-loader" class="page-loader" aria-hidden="true">
        <div class="page-loader__backdrop"></div>
        <div class="page-loader__content" role="status" aria-live="polite">
            <div class="page-loader__bar">
                <div class="page-loader__bar-fill"></div>
            </div>
            <div class="page-loader__text">Loading data...</div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/landing">PaxCounterWeb</a>
                <div class="d-flex align-items-center gap-2 ms-2 me-3">
                    <span class="badge @(autoModeEnabled ? "bg-success" : "bg-secondary")">GPS Auto: @(autoModeEnabled ? "ON" : "OFF")</span>
                    <span class="small text-muted">Tracker: @autoModeTrackerEntity | Home: @homeInterval s | Away: @awayInterval s</span>
                </div>
<div class="navbar-collapse d-flex flex-wrap align-items-center justify-content-between w-100">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/landing"><i class="bi bi-broadcast me-1"></i>Live</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Tracking" asp-action="Index"><i class="bi bi-map me-1"></i>Tracking</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/tracking/crowd"><i class="bi bi-people me-1"></i>Crowd</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/compare"><i class="bi bi-bar-chart-line me-1"></i>Compare</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-1"></i>Settings</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container d-flex flex-wrap align-items-center gap-2">
            <span>&copy; 2026 - PaxCounterWeb</span>
            <span class="text-muted">·</span>
            <a class="text-muted" href="/tracking"><i class="bi bi-map me-1"></i>Tracking</a>
            <span class="text-muted">·</span>
            <a class="text-muted" href="/tracking/crowd"><i class="bi bi-people me-1"></i>Crowd</a>
            <span class="text-muted">·</span>
            <a class="text-muted" href="/footfall"><i class="bi bi-grid-3x3-gap me-1"></i>Footfall</a>
            <span class="text-muted">·</span>
            <a class="text-muted" href="https://footfall.paxcounter.work/Sites/Detail/4?window=15m"><i class="bi bi-globe-americas me-1"></i>Footfall Map</a>
            <span class="text-muted">·</span>
            <a class="text-muted" href="/tracking/trackers"><i class="bi bi-geo-alt me-1"></i>Trackers</a>
            <span class="text-muted">·</span>
            <a class="text-muted" asp-area="" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock me-1"></i>Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* peter *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>






